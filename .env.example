# Copy to .env and fill in. Every value here is optional: with no keys set,
# judgekit runs against the deterministic stub provider, which is the default
# and needs no network.
#
# The CLI reads ./.env before every command. A real environment variable always
# wins over the file, so `JUDGEKIT_PROVIDER=stub judgekit run ...` still
# overrides what is written here.
#
# Trailing comments are stripped, so `groq   # or gemini` sets exactly "groq".

# JUDGEKIT_PROVIDER=stub          # stub | gemini | groq

# Which model judges. Each provider has its own default (groq:
# openai/gpt-oss-20b), and --model / -m overrides both this and that.
#
# Hosted model ids get retired, and the symptom is a 404 that reads like a
# broken install rather than a withdrawn model. List what your key can reach:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
# JUDGEKIT_MODEL=openai/gpt-oss-20b

# GEMINI_API_KEY=
# GROQ_API_KEY=

# Service mode (phases 5+)
# DATABASE_URL=postgresql+asyncpg://judgekit:judgekit@localhost:5432/judgekit
# REDIS_URL=redis://localhost:6379/0
# LOG_LEVEL=INFO

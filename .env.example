# Copy to .env and fill in. Every value here is optional:
# with no keys set, judgekit runs against the deterministic stub provider,
# which is the default and needs no network.

# JUDGEKIT_PROVIDER=stub          # stub | gemini | groq
# GEMINI_API_KEY=
# GROQ_API_KEY=

# Service mode (phases 5+)
# DATABASE_URL=postgresql+asyncpg://judgekit:judgekit@localhost:5432/judgekit
# REDIS_URL=redis://localhost:6379/0
# LOG_LEVEL=INFO
